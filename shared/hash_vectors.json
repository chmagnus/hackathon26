{
  "rules": [
    "canonical(text): replace CRLF then CR with LF; strip spaces and tabs from each line end; strip leading and trailing LF",
    "sha256(text): lowercase hex SHA-256 of the UTF-8 bytes",
    "genesis = sha256(canonical(star.body))",
    "moon.hash = sha256(prev_hash + canonical(moon.title) + LF + canonical(moon.body)), starting from genesis"

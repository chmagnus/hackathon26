# AI tutor providers, tried in order: workers_ai, gemini, mock (mock = canned offline replies)
AI_PROVIDERS=mock
# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Cloudflare Workers AI (the API token needs the Workers AI permission)
CF_ACCOUNT_ID=
CF_API_TOKEN=
WORKERS_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# Tutor questions per day before it replies with a limit message
TUTOR_DAILY_CAP=500
